# @noautodeps

load("@fbcode_macros//build_defs:cpp_library.bzl", "cpp_library")
load("../defs.bzl", "private_headers", "public_headers")
load("../tools/wasm/wasm_flags.bzl", "openzl_wasm_compiler_flags")

oncall("data_compression")

cpp_library(
    name = "openzl_cpp",
    srcs = glob([
        "src/**/*.cpp",
    ]),
    headers = public_headers(
        glob([
            "include/**/*.hpp",
        ])
    )
    | {
        header: header
        for header in [
            "src/openzl/cpp/experimental/trace/CborHelpers.hpp",
            "src/openzl/cpp/experimental/trace/ChunkTraceCore.hpp",
            "src/openzl/cpp/experimental/trace/Codec.hpp",
            "src/openzl/cpp/experimental/trace/CompressChunkTrace.hpp",
            "src/openzl/cpp/experimental/trace/CompressTracer.hpp",
            "src/openzl/cpp/experimental/trace/CompressionTraceHooks.hpp",
            "src/openzl/cpp/experimental/trace/DecompressChunkTrace.hpp",
            "src/openzl/cpp/experimental/trace/DecompressTracer.hpp",
            "src/openzl/cpp/experimental/trace/DecompressionTraceHooks.hpp",
            "src/openzl/cpp/experimental/trace/Graph.hpp",
            "src/openzl/cpp/experimental/trace/StreamVisualizer.hpp",
        ]
    },
    header_namespace = "",
    private_headers = private_headers(
        glob([
            "src/**/*.hpp",
        ])
    ),
    compiler_flags = openzl_wasm_compiler_flags(),
    exported_deps = [
        "..:zstronglib",
    ],
)
