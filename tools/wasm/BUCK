load("@bazel_skylib//lib:shell.bzl", "shell")
load("@fbcode_macros//build_defs:native_rules.bzl", "buck_filegroup", "cxx_genrule")
load("@fbcode_macros//build_defs:python_unittest.bzl", "python_unittest")
load("@fbsource//tools/build_defs:fb_native_wrapper.bzl", "fb_native")
load("@fbsource//tools/build_defs/testinfra:network_access_utils.bzl", "network_access_utils")
load("@fbsource//tools/target_determinator/macros:ci.bzl", "ci")
load("../../defs.bzl", "zs_library", "zs_unittest")
load(":wasm_flags.bzl", "OPENZL_WASM_LINKER_FLAGS")

oncall("data_compression")

# Native target - C only, JS lives in js/ for frontend consumption.
zs_library(
    name = "wasm",
    srcs = [
        "src/openzl_wasm.cpp",
    ],
    headers = {
        "src/openzl_wasm.h": "src/openzl_wasm.h",
        "tools/wasm/src/openzl_wasm.h": "src/openzl_wasm.h",
    },
    # Nothing in the WASM link references the binding's exports, so it would
    # otherwise be dropped from the archive
    link_whole = True,
    deps = [
        "../../cli/utils:profile_graphs",
        "../../custom_parsers:custom_parsers",
        "../training:train",
    ],
    exported_deps = [
        "../..:public_headers",
        "../..:zstronglib",
    ],
)

# Native gtest - validates profile table + compress/decompress roundtrip
# without Emscripten. Also runs under CMake as `ctest -R WasmBinding`.
zs_unittest(
    name = "test_wasm_binding",
    srcs = [
        "tests/test_wasm_binding.cpp",
        "tests/test_wasm_profiles.cpp",
    ],
    deps = [
        "..:arg",
        "../../cli/utils:utils",
        "../../cpp:openzl_cpp",
        "../../custom_parsers:custom_parsers",
        ":wasm",
    ],
)

# The JS wrapper, declared so the web tools that import it can depend on it.
# Globbed rather than enumerated, because a list is the same omission this
# target exists to fix: a file added to js/ later would go undeclared again.
#
# Emscripten's output (`js/openzl.*`) is excluded because it lands in this
# directory on any machine that has built the binding -- gitignored, and an
# input to nothing. js/tests/ is excluded because no web tool ships or runs it,
# so carrying it here would only rebuild the playground and the docs on a file
# neither reads.
buck_filegroup(
    name = "js_srcs",
    srcs = glob(
        ["js/**/*"],
        exclude = [
            "js/openzl.*",
            "js/tests/**",
        ],
    ),
)

python_unittest(
    name = "test_build_config",
    srcs = ["test_build_config.py"],
    base_module = "openzl.tools.wasm",
    labels = ci.labels(ci.linux(ci.opt()), overwrite = True),
    network_access = network_access_utils.none(),
    resources = {
        "CMakeLists.txt": "CMakeLists.txt",
        "src/openzl_wasm.h": "src/openzl_wasm.h",
        "wasm_flags.bzl": "wasm_flags.bzl",
    },
)

# The WASM artifact for the internal docs site. GitHub builds its own with
# CMake (see CMakeLists.txt here)
fb_native.platform(
    name = "emcc_wasm64",
    constraint_values = [
        "fbsource//xplat/third-party/zstd:block_compressors[all]",
        "ovr_config//build_mode/constraints:build_mode[release]",
        "ovr_config//build_mode/constraints:lto[none]",
        # js/wasm_api.js assumes 8-byte pointers, and training uses threads
        "ovr_config//features/wasm:memory64",
        "ovr_config//features/wasm:threads",
        "ovr_config//os/version/emscripten:4.0.19",
    ],
    deps = [
        "ovr_config//platform/wasm:emcc",
    ],
)

# openzl.js and openzl.wasm, which the docs build copies into js/
cxx_genrule(
    name = "openzl_wasm",
    out = "openzl_wasm",
    cmd = " ".join(
        [
            "mkdir -p $OUT &&",
            "$(ld)",
            "$(ldflags-static :wasm)",
        ]
        + [shell.quote(flag) for flag in OPENZL_WASM_LINKER_FLAGS]
        + [
            "-o $OUT/openzl.js &&",
            "$(exe fbsource//third-party/llvm-project:llvm-strip) --strip-debug $OUT/openzl.wasm",
        ],
    ),
    compatible_with = ["ovr_config//os:emscripten"],
    default_target_platform = ":emcc_wasm64",
    visibility = ["PUBLIC"],
)
