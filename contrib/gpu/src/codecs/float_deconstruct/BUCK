        platform = "gpu-remote-execution",
        use_case = "tpx-default",
    ),
    deps = [
        "../../../../..:zstronglib",
        "../../../../../cpp:openzl_cpp",
        "../../../testkit:testkit",
        "../../common:cuda_error",
