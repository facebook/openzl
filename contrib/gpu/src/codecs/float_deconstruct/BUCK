load("../../../../../defs.bzl", "relative_headers")

oncall("data_compression")

# bf16 run descriptor and element decode, free of CUDA headers so that host
# code shares them with the kernels.
cpp_library(
    # @autodeps-skip
    name = "float_deconstruct_bf16",
    headers = relative_headers(["float_deconstruct_bf16.hpp"]),
    header_namespace = "",
)

# Checks whether a float_deconstruct codec run fits a kernel, and builds the
# kernel's arguments. The kernels of every runtime share this code.
cpp_library(
    # @autodeps-skip
    name = "decode_float_deconstruct_binding",
    srcs = ["decode_float_deconstruct_binding.cpp"],
    headers = relative_headers(["decode_float_deconstruct_binding.hpp"]),
    header_namespace = "",
    deps = ["../../../../..:zstronglib"],
    exported_deps = [
        "../../common:codec_decode_execution",
        ":float_deconstruct_bf16",
    ],
)

# The decode kernels of float_deconstruct for the CUDA runtime.
cpp_library(
    # @autodeps-skip
    name = "decode_float_deconstruct_cuda",
    srcs = ["decode_float_deconstruct_cuda.cpp"],
    headers = relative_headers(["decode_float_deconstruct_cuda.hpp"]),
    header_namespace = "",
    deps = [
        "../../../../..:zstronglib",
        ":decode_float_deconstruct_bf16",
        ":decode_float_deconstruct_binding",
    ],
    exported_deps = ["../../common:codec_decode_execution"],
    external_deps = [("cuda", None, "cuda-lazy")],
)

cpp_unittest(
    # @autodeps-skip
    name = "decode_float_deconstruct_cuda_test",
    srcs = ["tests/DecodeFloatDeconstructCudaTest.cpp"],
    keep_gpu_sections = True,
    labels = [tpx_labels.serialize]
    + ci.labels(
        ci.replace({ci.linux(ci.dev()): ci.linux(ci.mode("fbcode//mode/dev-nosan"))}),
        ci.remove(ci.linux(ci.coverage(ci.mode("fbcode//mode/dev-cov")))),
    ),
    network_access = network_access_utils.none(),
    remote_execution = re_test_utils.remote_execution(
        platform = "gpu-remote-execution",
        use_case = "tpx-default",
    ),
    target_compatible_with = sanitizers.sanitizer_enabled(
        no = [],
        yes = ["ovr_config//:none"],
    ),
    deps = [
        "../../common:cuda_error",
        "../../common:cuda_raii",
        "../../device:cuda_device",
        "fbsource//third-party/googletest:gtest",
        ":bf16_test_frames",
        ":decode_float_deconstruct_cuda",
    ],
    external_deps = [("cuda", None, "cuda-lazy")],
)

