        "zstd_dict_trainer.h": "zstd_dict_trainer.h",
    },
    # Zstd's advanced dictionary-training declarations require this macro.
    # The fbcode dependency supplies it automatically; the WASM dependency does not.
    preprocessor_flags = select({
        "DEFAULT": [],
        "ovr_config//runtime:wasm": ["-DZDICT_STATIC_LINKING_ONLY"],
    }),
    deps = [
        "../..:logger",
        "../../../cpp:openzl_cpp",
        "../sample_collection:sample_collection",
    ],
    exported_deps = [
        "..:train_common",
        "../utils:training_utils",
    ],
    external_deps = [
        "zstd",
    ],
