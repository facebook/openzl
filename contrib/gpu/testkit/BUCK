load("@fbcode_macros//build_defs:cpp_library.bzl", "cpp_library")
load("@fbcode_macros//build_defs:cpp_unittest.bzl", "cpp_unittest")
load("@fbsource//tools/build_defs/testinfra:network_access_utils.bzl", "network_access_utils")
load("../../../defs.bzl", "relative_headers")

oncall("data_compression")

# Mints valid OpenZL frames with fully-controlled codec content (frame_factory)
# and verifies their codec lists via the real reflection API (frame_verifier).
# For building GPU-decoder test fixtures.
cpp_library(
    # @autodeps-skip
    name = "testkit",
    srcs = [
        "frame_factory.cpp",
        "frame_verifier.cpp",
        "multichunk_frame.cpp",
        "nimble_graph.cpp",
        "nimble_workloads.cpp",
    ],
    headers = relative_headers([
        "bytes.h",
        "frame_factory.h",
        "frame_verifier.h",
        "multichunk_frame.h",
        "nimble_graph.h",
        "nimble_workloads.h",
    ])
    | {
        header: header
        for header in [
            "bytes.h",
            "frame_factory.h",
            "frame_verifier.h",
            "multichunk_frame.h",
            "nimble_graph.h",
            "nimble_workloads.h",
        ]
    },
    header_namespace = "",
    exported_deps = [
        "../../..:zstronglib",
        "../../../cpp:openzl_cpp",
        "../../../tests:utils",
    ],
)

cpp_library(
    name = "testkit_relative_headers",
    headers = relative_headers([
        "bytes.h",
        "frame_factory.h",
        "frame_verifier.h",
        "multichunk_frame.h",
        "nimble_graph.h",
        "nimble_workloads.h",
    ]),
    header_namespace = "",
    exported_deps = [":testkit"],
)

# Test device whose memory is host memory, so CPU tests can run the host code
# that reads device memory.
cpp_library(
    # @autodeps-skip
    name = "host_memory_device",
    srcs = ["host_memory_device.cpp"],
    headers = relative_headers(["host_memory_device.h"]),
    header_namespace = "",
    exported_deps = ["../src/device:device"],
)

cpp_unittest(
    # @autodeps-skip
    name = "host_memory_device_test",
    srcs = ["tests/HostMemoryDeviceTest.cpp"],
    network_access = network_access_utils.none(),
    deps = [
        "fbsource//third-party/googletest:gtest",
        ":host_memory_device",
    ],
)

