load("@fbcode_macros//build_defs:cpp_library.bzl", "cpp_library")
load("@fbcode_macros//build_defs:cpp_unittest.bzl", "cpp_unittest")
load("@fbsource//tools/build_defs/testinfra:network_access_utils.bzl", "network_access_utils")
load("../../../../defs.bzl", "relative_headers")

oncall("data_compression")

# Shared CUDA error-check macros for GPU host code.
cpp_library(
    name = "cuda_error",
    headers = relative_headers(["cuda_error.cuh"]),
    header_namespace = "",
    exported_external_deps = [("cuda", None, "cuda-lazy")],
)

# Generic CUDA RAII helpers (owning device pointers, timing events, stream-ordered
# scratch) shared by the device-staging harness and the benchmark driver.
cpp_library(
    name = "cuda_raii",
    headers = relative_headers(["cuda_raii.cuh"]),
    header_namespace = "",
    exported_deps = [":cuda_error"],
    exported_external_deps = [("cuda", None, "cuda-lazy")],
)

# Kernel launch/occupancy helpers (grid sizing, occupancy metadata) for GPU host
# code; kernel-agnostic.
cpp_library(
    name = "cuda_launch",
    headers = relative_headers(["cuda_launch.cuh"]),
    header_namespace = "",
    exported_deps = [":cuda_error"],
    exported_external_deps = [("cuda", None, "cuda-lazy")],
)

# Balanced-segment preprocessing (host split + device staging) shared by GPU
# decode kernels; codec-agnostic (templated on the chunk descriptor).
cpp_library(
    name = "segment_plan",
    headers = relative_headers(["segment_plan.cuh"]),
    header_namespace = "",
    exported_deps = [
        ":cuda_error",
        ":cuda_raii",
    ],
    exported_external_deps = [("cuda", None, "cuda-lazy")],
)

cpp_library(
    name = "cuda_error_relative_headers",
    headers = relative_headers(["cuda_error.cuh"]),
    header_namespace = "",
    exported_deps = [],
    exported_external_deps = [("cuda", None, "cuda-lazy")],
)

cpp_library(
    name = "cuda_raii_relative_headers",
    headers = relative_headers(["cuda_raii.cuh"]),
    header_namespace = "",
    exported_deps = [
        ":cuda_error_relative_headers",
        ":cuda_raii",
    ],
    exported_external_deps = [("cuda", None, "cuda-lazy")],
)

# Host C++ error helpers. Device code reports errors through status arrays.
cpp_library(
    # @autodeps-skip
    name = "errors",
    srcs = ["errors.cpp"],
    headers = relative_headers(["errors.hpp"]),
    header_namespace = "",
    deps = ["../../../..:zstronglib"],
    exported_deps = ["../../../../cpp:openzl_cpp"],
)

cpp_unittest(
    # @autodeps-skip
    name = "errors_test",
    srcs = ["tests/ErrorsTest.cpp"],
    network_access = network_access_utils.none(),
    deps = [
        "../../../../cpp:openzl_cpp",
        "fbsource//third-party/googletest:gtest",
        ":error_testing",
        ":errors",
    ],
)

cpp_library(
    # @autodeps-skip
    name = "error_testing",
    headers = relative_headers(["tests/error_testing.hpp"]),
    header_namespace = "",
    exported_deps = ["../../../../cpp:openzl_cpp"],
)

# CPU metadata contract shared by codec planners and the decode scheduler.
cpp_library(
    # @autodeps-skip
    name = "codec_decode_planning",
    headers = relative_headers(["codec_decode_planning.hpp"]),
    header_namespace = "",
    exported_deps = [
        "../../../..:zstronglib",
        "../../../../cpp:openzl_cpp",
    ],
)
