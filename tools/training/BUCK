load("../../defs.bzl", "zs_cxxlibrary")

oncall("data_compression")

zs_cxxlibrary(
    name = "train",
    srcs = [
        "train.cpp",
    ],
    headers = {"tools/training/train.h": "train.h", "train.h": "train.h"},
    # ML selector training depends on XGBoost, which has no supported WASM build.
    preprocessor_flags = select({
        "DEFAULT": ["-DOPENZL_HAS_ML_SELECTOR_TRAINER=1"],
        "ovr_config//runtime:wasm": [],
    }),
    deps = [
        "../../custom_parsers:custom_parsers",
        "ace:automated_compressor_explorer",
        "clustering:clustering_graph_trainer",
        "dict:base_dict_trainer",
        "graph_mutation:graph_mutation",
        "lz:lz_trainer",
    ] + select({
        "DEFAULT": ["../ml_selector:ml_selector_trainer"],
        "ovr_config//runtime:wasm": [],
    }),
    exported_deps = [
        "..:logger",
        "utils:training_utils",
        ":train_common",
    ],
)

